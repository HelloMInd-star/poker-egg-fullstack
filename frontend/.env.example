# ============================================================
# Poker Face Arena · Frontend 环境变量示例
# 复制为 .env 后按需修改
# ============================================================

# ── 后端 API 地址 ───────────────────────────────────────────
# 本地开发：http://localhost:5000
# 生产环境：替换为 Railway/Render 等平台分配的 https 域名
VITE_API_URL=http://localhost:5000

# ── 后端 WebSocket 地址 ─────────────────────────────────────
# 本地开发：ws://localhost:5000
# 生产环境：替换为 wss:// 协议的后端域名（注意协议必须是 wss，不能是 https）
VITE_WS_URL=ws://localhost:5000
