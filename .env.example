# ============================================================
# Poker Face Arena · 扑克人格竞技场
# 根目录环境变量示例（docker-compose / 根容器使用）
# 复制为 .env 后按需修改
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
# Docker Compose 启动 PostgreSQL 时的超级用户密码
POSTGRES_PASSWORD=your_secure_password_here

# ── JWT 密钥 ────────────────────────────────────────────────
# 用户 Token 签名密钥 · 生产环境务必替换为强随机字符串（≥32位）
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── 后端服务配置（可选）─────────────────────────────────────
# 若通过根 .env 传递给后端容器，可在此设置（否则使用 backend/.env）
# DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/poker_face_arena
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=10080
# ENVIRONMENT=production
# PORT=8000

# ── CORS 允许源（逗号分隔）─────────────────────────────────
# 生产环境填入前端部署域名，本地开发已在代码中默认白名单
# CORS_ORIGINS=https://your-frontend.vercel.app,https://poker-face-arena.vercel.app

# ── Redis（规划中，暂未启用）────────────────────────────────
# REDIS_PASSWORD=your_redis_password
