# ============================================================
# Poker Face Arena · Backend 环境变量示例
# 复制为 .env 后按需修改
# ============================================================

# ── 数据库 ──────────────────────────────────────────────────
# PostgreSQL 连接串；未设置时后端自动降级为内存模式（重启数据丢失）
# Railway/Render 等平台添加 PostgreSQL 服务后会自动注入
DATABASE_URL=postgresql://postgres:password@localhost:5432/poker_face_arena

# ── JWT 认证 ────────────────────────────────────────────────
# Token 签名密钥 · 生产环境务必替换为强随机字符串（≥32位）
SECRET_KEY=change-me-to-a-long-random-hex-string

# JWT 签名算法（默认 HS256，一般无需修改）
JWT_ALGORITHM=HS256

# Token 过期时间（分钟），10080 = 7 天
JWT_EXPIRE_MINUTES=10080

# ── 运行环境 ────────────────────────────────────────────────
# development / production
ENVIRONMENT=development

# ── 服务端口 ────────────────────────────────────────────────
# Railway 等平台会通过 $PORT 自动注入，本地开发默认 5000
PORT=5000

# ── CORS 允许源 ─────────────────────────────────────────────
# 逗号分隔的前端域名列表；已内置本地开发域名白名单（localhost:3000/5173 + github pages）
# 生产环境务必填入前端部署域名
# 示例：CORS_ORIGINS=https://poker-face-arena.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=
